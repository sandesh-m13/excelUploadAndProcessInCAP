{
  "name": "excelUploader",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/sqlite": "^3",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-file-upload": "cds watch --open fileupload/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-board-games": "cds watch --open boardgames/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/file-upload",
    "app/board-games"
  ],
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  }
}
